# Sem estas variáveis, o workspace usa o repository mock.
# Para integração local direta, use NEXT_PUBLIC_API_URL=http://localhost:8000.
# No Render, use "/" para o browser consumir o proxy same-origin do Next.js.
NEXT_PUBLIC_API_URL=/

# Variável server-only usada pelo rewrite do Next.js. Nunca recebe credenciais.
BACKEND_API_URL=http://localhost:8000
