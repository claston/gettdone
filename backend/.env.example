# Runtime environment
APP_ENV=development

# Security baseline (required in production)
ACCESS_CONTROL_TOKEN_SECRET=change-me-with-32-plus-random-characters
ENABLE_API_DOCS=true
CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
UNLIMITED_ANON_QUOTA=false

# App behavior
ANONYMOUS_QUOTA_LIMIT=3
QUOTA_WINDOW_DAYS=7
ANALYSIS_TTL_SECONDS=86400
ANALYSIS_STORAGE=filesystem
CONVERSION_RESULTS_S3_PREFIX=conversion/results
CONVERSION_JOB_ACTIVE_TTL_SECONDS=86400
CONVERSION_JOB_TERMINAL_TTL_SECONDS=86400
CONVERSION_DOCUMENT_STORE=filesystem
CONVERSION_S3_BUCKET=
CONVERSION_S3_PREFIX=conversion/jobs
CONVERSION_S3_SERVER_SIDE_ENCRYPTION=AES256
CONVERSION_S3_KMS_KEY_ID=
# Privacy-validated synthetic PDFs for non-clean conversions (native-text PDFs only).
# Uses SSE-S3 (AES256) and never uploads the original PDF through this path.
CANONICAL_LAYOUT_CAPTURE_ENABLED=false
CANONICAL_LAYOUT_CAPTURE_S3_PREFIX=conversion/canonical-layouts/candidates/v1
CANONICAL_LAYOUT_CAPTURE_MAX_PAGES=20
CANONICAL_LAYOUT_CAPTURE_MAX_EXTRACTED_CHARS=250000
CONVERSION_ARCHITECTURE_MODE=legacy
CONVERSION_UPLOAD_MODE=proxy
CONVERSION_EXECUTION_MODE=inline_legacy
# Comma-separated verified user emails enabled for the AWS path while the global mode remains legacy.
CONVERSION_ASYNC_USER_EMAIL_ALLOWLIST=
CONVERSION_BATCH_MAX_FILES=12
CONVERSION_BATCH_REPOSITORY=postgres
CONVERSION_DIRECT_UPLOAD_TTL_SECONDS=900
CONVERSION_SQS_QUEUE_URL=
CONVERSION_SQS_MAX_RECEIVE_COUNT=5
CONVERSION_JOB_LEASE_SECONDS=900
CONVERSION_OUTBOX_DISPATCH_LIMIT=100
CONVERSION_LAMBDA_DB_POOL_MAX_SIZE=1
CONVERSION_MAX_CONCURRENCY=1
CONVERSION_BUSY_RETRY_AFTER_SECONDS=15
DATABASE_URL=
DATABASE_SCHEMA=public
PDF_OCR_ENABLED=
PDF_OCR_LANG=por+eng
PDF_OCR_MAX_PAGES=12
PDF_OCR_DPI=250
PDF_OCR_MAX_FILE_MB=5
PDF_OCR_PAGE_TIMEOUT_SECONDS=12
PDF_OCR_CONCURRENCY_LIMIT=1

# Optional Textract OCR for scanned PDFs
TEXTRACT_ENABLED=
TEXTRACT_MODE=text
TEXTRACT_FORCE=
AWS_REGION=us-east-1
TEXTRACT_TEMP_BUCKET=
TEXTRACT_S3_PREFIX=textract/tmp/
TEXTRACT_JOB_POLL_INTERVAL_SECONDS=2
TEXTRACT_JOB_TIMEOUT_SECONDS=600
TEXTRACT_FEATURE_TYPES=TABLES,LAYOUT

# Optional Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
FRONTEND_BASE_URL=http://localhost:3000
GOOGLE_OAUTH_STATE_TTL_SECONDS=600
