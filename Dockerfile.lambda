# Production Debian distroless worker, rebuilt from the selected main commit.
ARG PYTHON_IMAGE=python:3.12-slim-trixie@sha256:a0f57064cbdcd6285fa45f51237ab0b35ea8ebaed06a1f5973e89e19dfb86704
ARG RUNTIME_IMAGE=gcr.io/distroless/cc-debian13:nonroot@sha256:3ee00291cf386ec52a552e6a858d555debd74776eb4bfa53fa3df2cd6677515e
FROM ${PYTHON_IMAGE} AS build
ENV PIP_DISABLE_PIP_VERSION_CHECK=1 PIP_NO_CACHE_DIR=1
WORKDIR /build
# Install only the corrected official zlib package, using signed snapshot indexes.
# The rest of the build/runtime stays on the pinned Debian 13 images.
RUN set -eu; printf '%s\n' \
      'deb [check-valid-until=no signed-by=/usr/share/keyrings/debian-archive-keyring.gpg] https://snapshot.debian.org/archive/debian/20261105T060000Z/ sid main' > /tmp/zlib.list \
    && apt-get -o Dir::Etc::sourcelist=/tmp/zlib.list -o Dir::Etc::sourceparts=- update \
    && apt-get -o Dir::Etc::sourcelist=/tmp/zlib.list -o Dir::Etc::sourceparts=- download zlib1g=1:1.3.dfsg+really1.3.2-4 \
    && dpkg -i /build/zlib1g_*.deb \
    && rm /tmp/zlib.list
COPY backend/requirements-worker.txt ./
RUN python -m pip install --only-binary=:all: --target /build/site-packages -r requirements-worker.txt
# Keep compression, XML, ctypes and dbm support, including real package
# metadata and licenses. No package database is deleted or rewritten to hide CVEs.
# SQLite belongs to the excluded API access-control code, not this worker.
RUN set -eu; mkdir -p /runtime-libs /runtime-status \
    && dpkg-deb -x /build/zlib1g_*.deb /runtime-libs \
    && dpkg-query -s zlib1g > /runtime-status/zlib1g \
    && cp "/var/lib/dpkg/info/zlib1g:$(dpkg --print-architecture).md5sums" /runtime-status/zlib1g.md5sums \
    && for package in libbz2-1.0 libffi8 libgdbm6t64 libdb5.3t64 liblzma5 libcrypt1; do \
         dpkg-query -s "$package" > "/runtime-status/$package"; \
         dpkg-query -L "$package" | grep -E '/lib[^/]+\.so(\.|$)' | while IFS= read -r library; do \
           cp --parents --dereference "$library" /runtime-libs; \
         done; \
         cp --parents "/usr/share/doc/$package/copyright" /runtime-libs; \
       done \
    && rm -rf /usr/local/lib/python3.12/site-packages \
              /usr/local/lib/python3.12/tkinter \
              /usr/local/lib/python3.12/sqlite3 \
    && rm -f /usr/local/lib/python3.12/lib-dynload/_curses*.so \
             /usr/local/lib/python3.12/lib-dynload/readline*.so \
             /usr/local/lib/python3.12/lib-dynload/_tkinter*.so \
             /usr/local/lib/python3.12/lib-dynload/_sqlite3*.so \
             /usr/local/lib/python3.12/lib-dynload/_uuid*.so

FROM ${RUNTIME_IMAGE} AS runtime
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PYTHONPATH=/var/task APP_RUNTIME_TMP_DIR=/tmp/gettdone
ENV LD_LIBRARY_PATH=/usr/local/lib
ARG APP_RELEASE=local
ENV APP_RELEASE=${APP_RELEASE}
WORKDIR /var/task
COPY --from=build /usr/local/bin/python3.12 /usr/local/bin/python3.12
COPY --from=build /usr/local/lib/libpython3.12.so.1.0 /usr/local/lib/libpython3.12.so.1.0
COPY --from=build /usr/local/lib/python3.12 /usr/local/lib/python3.12
# Remove the replaced binary, then install the complete official package files
# and its authentic status/checksums. Runtime execution remains unprivileged.
USER 0
RUN ["/usr/local/bin/python3.12", "-c", "from pathlib import Path; Path('/usr/lib/x86_64-linux-gnu/libz.so.1.3.1').unlink()"]
COPY --from=build /runtime-libs/ /
COPY --from=build /runtime-status/ /var/lib/dpkg/status.d/
COPY scripts/check_worker_zlib.py /opt/check_worker_zlib.py
USER 65532:65532
RUN ["/usr/local/bin/python3.12", "/opt/check_worker_zlib.py"]
COPY --from=build /build/site-packages /var/task
COPY backend/app/__init__.py /var/task/app/__init__.py
COPY backend/app/adapters /var/task/app/adapters
COPY backend/app/application /var/task/app/application
COPY backend/app/data /var/task/app/data
COPY backend/app/workers /var/task/app/workers
RUN ["/usr/local/bin/python3.12", "-c", "import ctypes, glob; [ctypes.CDLL(path) for path in glob.glob('/usr/local/lib/python3.12/lib-dynload/*.so')]"]
RUN ["/usr/local/bin/python3.12", "-m", "app.workers.worker_image_contract"]
ENTRYPOINT ["/usr/local/bin/python3.12", "-m", "awslambdaric"]
CMD ["app.workers.conversion_lambda.lambda_handler"]
